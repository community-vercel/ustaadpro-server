{
    "watch":  [
                  "server.js",
                  "bot.js",
                  "controllers",
                  "routes",
                  "models",
                  "services",
                  "utils",
                  "config",
                  "db",
                  "middlewares"
              ],
    "ignore":  [
                   "auth_data/**",
                   "node_modules/**",
                   "uploads/**",
                   "*.log",
                   "bot-state.json",
                   "bot-pid.json",
                   "bot-error.log"
               ],
    "ext":  "js,mjs,cjs,json",
    "delay":  "500"
}
