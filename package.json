{
    "name": "ustaadpro_server",
    "version": "1.0.0",
    "description": "Backend API for UstaadPro app in Express and PostgreSQL",
    "main": "server.js",
    "type": "module",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon --config nodemon.json server.js",
        "dev:both": "concurrently \"nodemon --config nodemon.json server.js\" \"nodemon --config nodemon.json bot.js\"",
        "dev:bot": "nodemon --config nodemon.json bot.js",
        "bot": "node bot.js",
        "schema": "node db/run-schema.js",
        "seed": "node db/seed.js",
        "seedPassword": "node db/seedPassword.js",
        "seed:password": "node db/seedPassword.js",
        "seed:shop:alwaqas": "node scripts/importAlwaqasProducts.js",
        "seed:shop:prices": "node scripts/importAlwaqasProducts.js",
        "seed:services": "node serviceSeed.js",
        "migrate:mysql-to-postgres": "node db/migrate-mysql-to-postgres.js"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.0",
        "firebase-admin": "^10.3.0",
        "jsonwebtoken": "^9.0.2",
        "mysql2": "^3.11.0",
        "nodemailer": "^9.0.1",
        "pg": "^8.13.1",
        "puppeteer": "^25.3.0",
        "qrcode": "^1.5.4",
        "qrcode-terminal": "^0.12.0",
        "whatsapp-web.js": "^1.34.7",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "nodemon": "^3.1.4"
    },
    "keywords": [],
    "author": "",
    "license": "ISC"
}
