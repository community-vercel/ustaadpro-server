        <script type="text/javascript">
        function parentClick() {
          $('.appimgbg').removeClass("on");
        };
        
        $(function() {
            document.querySelector('.appimgbg .box').addEventListener('click', function(e) {
              e.stopPropagation();
            });
            $("#zoomview").click(function () {
                $('.appimgbg').addClass("on");
                var imgid = $('.mz-thumb-selected').attr('data-imgid');
                $('#appimg .left .img').removeClass('active');
                $('#appimg .left .img').eq(imgid).addClass('active');
                $('#appimg .right .img').removeClass('active');
                $('#appimg .right .img').eq(imgid).addClass('active');
            });
            $(".appimgbg .cloes").click(function() {
                $('.appimgbg').removeClass("on");
            });
            $("#appimg .left .img").click(function () {
                $(this).toggleClass("big");
            });
            $("#appimg .right .img").click(function () {
                $('#appimg .right .img').removeClass('active');
                $(this).addClass("active");
                var imgid = $(this).attr('data-imgid');
                $('#appimg .left .img').removeClass('active');
                $('#appimg .left .img').eq(imgid).addClass('active');
            });
        });
        </script>
