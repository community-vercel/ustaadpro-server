  gtag('js', new Date());

  gtag('config', 'AW-16696089480',{'allow_enhanced_conversions':true});
</script>

<script>
  window.addEventListener('load',function() {
    <!-- 电话统计 --> 
    document.querySelectorAll("a[href^='tel:']").forEach((e) => {
        e.addEventListener('click', () => {
           gtag('event', 'ga4_tel');
   gtag('event', 'conversion', {'send_to': 'AW-16696089480/g3uVCNXzhdQZEIi3qJk-'});
        })
    })
    <!-- 邮箱统计 -->
    document.querySelectorAll("a[href^='mailto:']").forEach((e) => {
        e.addEventListener('click', () => {
           gtag('event', 'ga4_email');
  gtag('event', 'conversion', {'send_to': 'AW-16696089480/H86oCOjN_tMZEIi3qJk-'});
        })
    })
    <!-- 表单提交 -->

            document.querySelectorAll('button[type="button"]').forEach(function(e){
            e.addEventListener('click',function(){
                var forms=this.closest("form")
                var email=forms.querySelector('input[name="email"]').value;       
                const emailRegularExpression = /^(([^<>()[\]\\.,;:\s@\"]+(\.[^<>()[\]\\.,;:\s@\"]+)*)|(\".+\"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
          
                if(email!="" && emailRegularExpression.test(email)){
gtag('set', 'user_data',{'email': email})
                    gtag('event', 'ga4_form');
   gtag('event', 'conversion', {'send_to': 'AW-16696089480/_PX6CLbL_tMZEIi3qJk-'});
                }
            })
      })

    <!-- whatsapp统计 -->
    document.querySelectorAll("a[href*='whatsapp']").forEach((e) => {
        e.addEventListener('click', () => {
           gtag('event', 'ga4_whatsapp');
  gtag('event', 'conversion', {'send_to': 'AW-16696089480/sY5zCLnL_tMZEIi3qJk-'});
        })
    })
     }) 
  </script>
</body>
<script>
    var swiper = new Swiper(".mySwiper", {
        direction: "vertical",
        slidesPerView: 6,
        spaceBetween: 0,
        navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
        },
    });
    $(".middle .middle-three .left .product-thumbs .swiper-slide a").hover(function () {
        $("#sourceImage").attr("src", $(this).find("img").attr("src"));
    });
    $(".middle .middle-three .left .product-thumbs .swiper-slide a").click(function () {
        $(".middle .middle-three .left .product-thumbs .swiper-slide").removeClass("active");
        $(this).parent().addClass("active");
        $("#sourceImage").attr("src", $(this).find("img").attr("src"));
    });
    $(".middle .middle-four .tabs .tab").click(function () {
        $(".middle .middle-four .tabs .tab").removeClass("active");
        $(this).addClass("active");
    });
    $(".middle .middle-nine .right .dropdown-box").click(function () {
        $(".middle .middle-nine .right .dropdown-box").removeClass("active");
        $(".middle .middle-nine .right .dropdown-box").find(".title").find(".but").html("+");
        $(this).addClass("active");
        $(this).find(".title").find(".but").html("-");
    });
    $(function () {
        var navEl = $("#tabs");
        $(window).scroll(function (e) {
            var scrollTop = $(window).scrollTop();
            if (scrollTop >= 700) {
                navEl.addClass("fadeInDown");
            } else {
                navEl.removeClass("fadeInDown");

            }
        }).trigger("scroll");
    });

    function go(id, url) {
        var vid = id;
        if (!url) {
            $('#video-' + vid).hide(); // 隐藏视频
        } else {
            $("#video-" + vid).prop("src", url);
        }
    }
</script>
</html>