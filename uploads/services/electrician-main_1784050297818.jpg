<style>
    .infoGroup p {
        margin-bottom: 0px !important;
    }

    #linkItems {
        justify-content: flex-start !important;
    }

    .accordion {
        cursor: pointer;
        width: 100%;
        border: none;
        text-align: left;
        outline: none;
        transition: 0.4s;
        position: relative;
    }

    .accordion h4 {
        float: left;
        width: 100%;
    }

    #linkItems h4:before {
        position: absolute;
        top: 8px;
        left: 0;
        right: 0;
        height: 23px;
        overflow: hidden;
        color: #bd2e2a;
        font-size: 45px;
        line-height: 1;
        letter-spacing: 1px;
        white-space: nowrap;
        content: "- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -";
        width: 80%;
    }

    #linkItems h4 {
        padding-bottom: 10px;
    }

    .active,
    .accordion:hover {
        /* background-color: #ccc; */
    }

    .accordion:after {
        content: '\25BC';
        font-weight: bold;
        position: absolute;
        right: 75px;
        top: 50%;
        transform: translateY(-50%);
        transition: transform 0.4s ease;
        color: #bd2e2a;
    }

    .active:after {
        transform: translateY(-50%) rotate(180deg);
        /* Rotate arrow */
    }

    .panel.legal-links {
        overflow: hidden;
        transition: max-height 0.2s ease-out;
        max-height: 0;
    }

    @media only screen and (max-width: 600px) {
        #agent {
            height: auto !important;
        }

        #agent-wrapper {
            padding: 5px;
            padding-bottom: 35px !important;
            padding-top: 35px !important;
        }
    }
</style>




