    //         if (defaultForm) {
    //             defaultForm.classList.add('hidedefaultform');
    //             defaultForm.classList.remove('showdefaultform');
    //         }
    //     } else {
    //         // If neither contactform nor contactForm exists, show the defaultform
    //         if (defaultForm) {
    //             defaultForm.classList.add('showdefaultform');
    //             defaultForm.classList.remove('hidedefaultform');
    //         }
    //     }
    // });


    const pageHeader = document.querySelector(".page-header");
    const toggleMenu = pageHeader.querySelector(".toggle-menu");
    const menuWrapper = pageHeader.querySelector(".menu-wrapper");
    const level1Links = pageHeader.querySelectorAll(".level-1 > li > a");
    const listWrapper2 = pageHeader.querySelector(".list-wrapper:nth-child(2)");
    const listWrapper3 = pageHeader.querySelector(".list-wrapper:nth-child(3)");
    const listWrapper4 = pageHeader.querySelector(".list-wrapper:nth-child(4)");
    const subMenuWrapper2 = listWrapper2.querySelector(".sub-menu-wrapper");
    const subMenuHeading1 = document.getElementById('back-button');
    const subMenuHeading2 = document.getElementById('back-button-two');
    const subMenuHeading3 = document.getElementById('back-button-three');
    const besLogo = document.getElementById('bes-logo-desktop');
    // const subMenuWrapper2ul = subMenuWrapper2.querySelector(".sub-menu");
    const subMenuWrapper3 = listWrapper3.querySelector(".sub-menu-wrapper");
    const subMenuWrapper4 = listWrapper4.querySelector(".sub-menu-wrapper");
    const backOneLevelBtns = pageHeader.querySelectorAll(".back-one-level");
    const isVisibleClass = "is-visible";
    const isActiveClass = "is-active";

    toggleMenu.addEventListener("click", function() {
        menuWrapper.classList.toggle(isVisibleClass);
        toggleMenu.classList.toggle(isVisibleClass);
        if (!this.classList.contains(isVisibleClass)) {
            listWrapper2.classList.remove(isVisibleClass);
            listWrapper3.classList.remove(isVisibleClass);
            listWrapper4.classList.remove(isVisibleClass);
            const menuLinks = menuWrapper.querySelectorAll("a");
            for (const menuLink of menuLinks) {
                menuLink.classList.remove(isActiveClass);
            }
        }
    });

    function moveParentTitle(title, siblingList, url) {
        // Check if an element with the class 'menu-header-list' already exists
        const existingHeader = siblingList.querySelector('.menu-header-list');

        // If it exists, you can choose to skip creating and inserting a new li element
        if (existingHeader) {
            console.log("Element with class 'menu-header-list' already exists.");
            return;
        }

        // If it doesn't exist, create and insert the new li element
        const li = document.createElement("li");
        li.classList.add('text-2xl');
        li.classList.add('menu-header-list');

        const anchor = document.createElement("a");
        anchor.href = url; // Set the href attribute using the provided URL
        anchor.appendChild(document.createTextNode("Explore " + title));

        li.appendChild(anchor);
        siblingList.insertBefore(li, siblingList.firstChild);
    }


    for (const level1Link of level1Links) {
        level1Link.addEventListener("click", function(e) {

            subMenuHeading2.textContent = e.srcElement.innerHTML;
            const siblingList = level1Link.nextElementSibling;

            if (siblingList) {
                e.preventDefault();
                let title = "Explore " + e.srcElement.innerText;
                let url = e.srcElement.getAttribute('href'); // Get the URL from the clicked element
                if (siblingList.getElementsByTagName("li")[0].innerHTML !== title) {
                    moveParentTitle(e.srcElement.innerText, siblingList, url); // Pass the URL as the third parameter
                }
                this.classList.add(isActiveClass);
                const cloneSiblingList = siblingList.cloneNode(true);
                subMenuWrapper2.innerHTML = "";
                subMenuWrapper2.append(cloneSiblingList);
                listWrapper2.classList.add(isVisibleClass);
            }
        });
    }


    listWrapper2.addEventListener("click", function(e) {
        const target = e.target;
        subMenuHeading3.textContent = e.srcElement.innerHTML;
        if (target.tagName.toLowerCase() === "a" && target.nextElementSibling) {
            const siblingList = target.nextElementSibling;
            e.preventDefault();
            let title = "Explore " + e.srcElement.innerText;
            let url = e.srcElement.getAttribute('href'); // Get the URL from the clicked element

            if (siblingList.getElementsByTagName("li")[0].innerHTML !== title) {
                moveParentTitle(e.srcElement.innerText, siblingList, url); // Pass the URL as the third parameter
            }
            target.classList.add(isActiveClass);
            const cloneSiblingList = siblingList.cloneNode(true);
            subMenuWrapper3.innerHTML = "";
            subMenuWrapper3.append(cloneSiblingList);
            listWrapper3.classList.add(isVisibleClass);
        }
    });

    listWrapper3.addEventListener("click", function(e) {
        const target = e.target;
        if (target.tagName.toLowerCase() === "a" && target.nextElementSibling) {
            const siblingList = target.nextElementSibling;
            e.preventDefault();
            let title = "Explore " + e.srcElement.innerText;
            let url = e.srcElement.getAttribute('href'); // Get the URL from the clicked element

            if (siblingList.getElementsByTagName("li")[0].innerHTML !== title) {
                moveParentTitle(e.srcElement.innerText, siblingList, url); // Pass the URL as the third parameter
            }
            target.classList.add(isActiveClass);
            const cloneSiblingList = siblingList.cloneNode(true);
            subMenuWrapper4.innerHTML = "";
            subMenuWrapper4.append(cloneSiblingList);
            listWrapper4.classList.add(isVisibleClass);
        }
    });

    for (const backOneLevelBtn of backOneLevelBtns) {
        backOneLevelBtn.addEventListener("click", function() {
            const parent = this.closest(".list-wrapper");
            parent.classList.remove(isVisibleClass);
            parent.previousElementSibling
                .querySelector(".is-active")
                .classList.remove(isActiveClass);
        });
    }


    // Desktop Menu
    var timer;
    jQuery(".bes-nav-top-level > #primary-menu > ul > li.menu-item-has-children").on({
        click: function(e) {
            e.preventDefault();
            const currentTargetClass = 'bes-classes-' + e.target.innerText.toLowerCase().replace(' ', '');
            if (jQuery(this).hasClass('needle__menu-active')) {

                jQuery('.menu__backdrop').fadeOut(420);
                jQuery('body').removeClass('needle__menu-overlay');
                jQuery('.bes-nav-second-level-container').addClass('hidden');
                jQuery('.bes-nav-second-level-container').children('.sub-menu').remove();
                jQuery('.menu-item').removeClass('needle__menu-active');
                // jQuery('.bes-nav-second-level-container').removeClass(currentTargetClass);


                jQuery('.bes-nav-second-level-container').removeClass(function(index, className) {
                    // Use a regular expression to test if the class name contains "bes-classes-"
                    return (className.match(/(?:^|\s)bes-classes-\S+/g) || []).join(' ');
                });
            } else {

                jQuery('.bes-nav-second-level-container').removeClass(function(index, className) {
                    // Use a regular expression to test if the class name contains "bes-classes-"
                    return (className.match(/(?:^|\s)bes-classes-\S+/g) || []).join(' ');
                });
                jQuery('body').addClass('needle__menu-overlay');

                jQuery('.menu__backdrop').fadeIn(240);

                jQuery('.menu-item').removeClass('needle__menu-active');
                jQuery(this).addClass('needle__menu-active');

                const firstLink = jQuery(this).find('a');


                const subMenu = jQuery('.bes-nav-second-level-container > .sub-menu').addClass(currentTargetClass);
                jQuery('.bes-nav-second-level-container').addClass(currentTargetClass);
                jQuery(this).addClass('top-level-menu-active ' + currentTargetClass);

                const linkText = e.target.outerText.replace("'", "");

                if (jQuery('.bes-nav-second-level-container > .sub-menu').hasClass('zero-block')) {
                    jQuery('.bes-nav-second-level-container > .sub-menu.zero-block').remove();
                    jQuery('.bes-nav-second-level-container .sub-menu.second-level').remove();
                    jQuery('.bes-nav-second-level-container .sub-menu.third-level').remove();
                }

                const menu = jQuery(e.currentTarget).children('.sub-menu').addClass('flex flex-col zero-block self-start w-1/3').clone();
                const containerDiv = jQuery('.bes-nav-second-level-container').removeClass('hidden').addClass('bes-active-menu');
                besMoveMenu(menu, firstLink[0], e.currentTarget.className, linkText);

            }

        }
    });

    // Close on backdrop
    jQuery('.menu__backdrop').on('click', function(e) {
        if (jQuery('body').hasClass('needle__menu-overlay')) {
            jQuery('.menu__backdrop').fadeOut(420);
            jQuery('body').removeClass('needle__menu-overlay');
            jQuery('.bes-nav-second-level-container').addClass('hidden');
            jQuery('.bes-nav-second-level-container').children('.sub-menu').remove();
            jQuery('.menu-item').removeClass('needle__menu-active');
        }
    });

    function besMoveMenu(menu, link, classes, linkName) {
        const container = jQuery(".bes-nav-second-level-container");
        container.append(menu).animate({
            opacity: '1'
        });

        jQuery(".bes-nav-second-level-container > .sub-menu.zero-block").prepend("<li class='" + classes.replace("menu-item-has-children", "") + "'><a class='!font-semibold' href='" + link + "'>Explore " + linkName.replace("'", "") + "</a>")

        jQuery(".bes-nav-second-level-container > .sub-menu > li").on("mouseenter", function(event) {
            event.preventDefault();

            const anchor = jQuery(this).children();

            jQuery(".bes-nav-second-level-container > .sub-menu > li").each(function(index) {
                jQuery(this).removeClass('active-menu-item');
            });
            jQuery(this).addClass('active-menu-item');
            jQuery('.bes-nav-second-level-container > .sub-menu.second-level').remove();
            jQuery('.bes-nav-second-level-container > .sub-menu.third-level').remove();
            const menu = jQuery(this).children('.sub-menu').addClass('flex flex-col second-level self-start w-1/3').clone();
            const containerDiv = jQuery('.bes-nav-second-level-container');
            containerDiv.append(menu);

            jQuery(".bes-nav-second-level-container > .sub-menu.second-level").prepend("<li class='" + jQuery(this).attr('class').replace("menu-item-has-children", "").replace("active-menu-item", "") + "'><a class='!font-semibold' href='" + anchor[0] + "'>Explore " + anchor[0].innerHTML + "</a></li>");

            jQuery(".bes-nav-second-level-container > .sub-menu.second-level > li.menu-item-has-children").on("mouseenter", function(event) {
                event.preventDefault();

                const anchor = jQuery(this).children();

                jQuery(".bes-nav-second-level-container > .sub-menu.second-level > li").each(function(index) {
                    jQuery(this).removeClass('active-menu-item');
                });

                jQuery(this).addClass('active-menu-item');
                jQuery('.bes-nav-second-level-container > .sub-menu.third-level').remove();
                const menu = jQuery(this).children('.sub-menu').addClass('flex flex-col third-level self-start w-1/3').clone();
                const containerDiv = jQuery('.bes-nav-second-level-container');
                containerDiv.append(menu);

                jQuery(".bes-nav-second-level-container > .sub-menu.third-level").prepend("<li class='" + jQuery(this).attr('class').replace("menu-item-has-children", "").replace("active-menu-item", "") + "'><a class='!font-semibold' href='" + anchor[0] + "'>Explore " + anchor[0].innerHTML + "</a></li>");

            });

            jQuery(".bes-nav-second-level-container > .sub-menu.second-level > li").on("mouseenter", function(event) {
                event.preventDefault();
                if (!jQuery(this).hasClass('menu-item-has-children')) {
                    jQuery(".bes-nav-second-level-container > .sub-menu.second-level > li").each(function(index) {
                        jQuery(this).removeClass('active-menu-item');
                    });
                    jQuery('.bes-nav-second-level-container > .sub-menu.third-level').remove();
                }
            });

        });

    }

    function besRemoveSubMenu() {
        jQuery(".bes-nav-second-level-container > .sub-menu").remove();
        jQuery(".bes-nav-second-level-container").removeClass('pt-[20px]').removeClass('pb-[20px]');
    }

    // Header Intro Scroll
    jQuery(window).on('scroll', function() {
        var scrollDistance = jQuery(window).scrollTop();

        // Logo sizer
        var initialImageHeight = 500;
        var minHeight = 0;
        var newImageHeight = initialImageHeight - scrollDistance;
        newImageHeight = Math.max(newImageHeight, minHeight);
        jQuery('.bes-header-desktop-extension').css('height', newImageHeight + 'px');

        // Show elements
        if (scrollDistance > 100) {
            jQuery('.home .bes-header-desktop-extension').addClass('remove');
        } else {
            jQuery('.home .bes-header-desktop-extension').removeClass('remove');
        }
        if (scrollDistance > 200) {
            jQuery('.home .bes-logo-desktop').css('opacity', 1);
            // jQuery('.home .fullSliderWrapper').css('opacity', 1);
        } else {
            jQuery('.home .bes-logo-desktop').css('opacity', 1); // jQuery('.home .fullSliderWrapper').css('opacity', 0);

        }

    });

    //# sourceURL=besdebug.js
</script>

<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {

        setTimeout(function() {
            var cafReadMoreLinks = document.querySelectorAll('a.caf-read-more');
            cafReadMoreLinks.forEach(function(link) {
                link.removeAttribute('target');
            });
        }, 3000); // 3000 milliseconds = 3 seconds

        // Find the .dropdown element
        var dropdown = document.querySelector('.dropdown');

        if (dropdown !== null && dropdown.length > 0) {
            // Find the first <span> element with class "init" inside the .dropdown element
            var initSpan = dropdown.querySelector('.init span');

            // Change the text content of the <span> element to "Filter:"
            initSpan.textContent = "Filter:";
        }

    });

    // Function to execute when the class is added
    function onClassAdded() {

        // Delay the execution for 3 seconds
        var postLayoutElements = document.querySelectorAll(".caf-post-layout1");

        if (postLayoutElements.length < 4) {

            console.log("Less than 4 elements with class '.caf-post-layout1'");


            var fourthElement = postLayoutElements[2]; // The fourth element, index 3 (0-based)
            fourthElement.classList.add("lessThanFour");

        }

        if (postLayoutElements.length > 4) {

            console.log("Less than 4 elements with class '.caf-post-layout1'");


            var fourthElement = postLayoutElements[2]; // The fourth element, index 3 (0-based)
            fourthElement.classList.add("lessThanFour");
            var fifthElement = postLayoutElements[3]; // The fourth element, index 3 (0-based)
            fifthElement.classList.add("lessThanFour");
        }
        // 3000 milliseconds (3 seconds)


    }

    // Select the element by its ID
    const targetElement = document.getElementById("caf-filter-layout2");
    if (targetElement !== null && targetElement.length > 0) {
        let isFetching = false; // A flag to track whether "fetching" class is currently present

        // Create a MutationObserver
        const observer = new MutationObserver(function(mutationsList) {
            for (const mutation of mutationsList) {
                if (mutation.type === "attributes" && mutation.attributeName === "class") {
                    const hasFetchingClass = targetElement.classList.contains("fetching");

                    if (hasFetchingClass && !isFetching) {
                        // "fetching" class is added for the first time
                        isFetching = true;
                        onClassAdded();
                        // You can add your code here to handle the fetching state
                    } else if (!hasFetchingClass && isFetching) {
                        // "fetching" class is removed
                        isFetching = false;
                        // Now you can execute the function to handle the loaded state
                        onClassRemoved();

                    }
                }
            }
        });
    }


    // Select the element by its ID
    const targetElement2 = document.getElementById("caf-post-layout-container");
    if (targetElement2 !== null && targetElement2.length > 0) {
        let isFetchingTwo = false; // A flag to track whether "fetching" class is currently present

        // Create a MutationObserver
        const observertwo = new MutationObserver(function(mutationsListTwo) {
            for (const mutationTwo of mutationsListTwo) {
                if (mutationTwo.type === "attributes" && mutationTwo.attributeName === "class") {
                    const hasFetchingClassTwo = targetElement2.classList.contains("fetching");

                    if (hasFetchingClassTwo && !isFetchingTwo) {
                        // "fetching" class is added for the first time
                        isFetchingTwo = true;
                        onClassAdded();
                        // You can add your code here to handle the fetching state
                    } else if (!hasFetchingClassTwo && isFetchingTwo) {
                        // "fetching" class is removed
                        isFetchingTwo = false;
                        // Now you can execute the function to handle the loaded state
                        onClassRemoved();

                    }
                }
            }
        });
        // Configure and start observing the target element for attribute changes
        observertwo.observe(targetElement2, {
            attributes: true,
            attributeFilter: ["class"]
        });
    }

    function onClassRemoved() {
        onClassAdded();
        // This function will be executed when the "fetching" class is removed
        // Indicating that the data is loaded
        console.log("Data is loaded. 'fetching' class removed.");
        // You can place your code to handle the loaded state here
    }
</script>

