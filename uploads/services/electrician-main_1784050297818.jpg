<script defer type="text/javascript" src="https://secure.leadforensics.com/js/61786.js"></script>

<!-- GCLID SCRIPT -->
<script>
    function getParam(p) {
        let match = RegExp('[?&]' + p + '=([^&]*)').exec(window.location.search);
        return match && decodeURIComponent(match[1].replace(/\+/g, ' '));
    }

    function getExpiryRecord(value) {
        let expiryPeriod = 90 * 24 * 60 * 60 * 1000; // 90 day expiry in milliseconds

        let expiryDate = new Date().getTime() + expiryPeriod;

        return {
            value: value,
            expiryDate: expiryDate
        };
    }

    function addGclid() {
        let gclidParam = getParam('gclid');
        let gclidRecord = null;
        let gclsrcParam = getParam('gclsrc');
        let isGclsrcValid = !gclsrcParam || gclsrcParam.indexOf('aw') !== -1;

        if (gclidParam && isGclsrcValid) {
            gclidRecord = getExpiryRecord(gclidParam);
            localStorage.setItem('gclid', JSON.stringify(gclidRecord));
        }

        let gclid = gclidRecord || JSON.parse(localStorage.getItem('gclid'));
        let isGclidValid = gclid && new Date().getTime() < gclid.expiryDate;

        let gclidFieldContainers = [...document.getElementsByClassName('js-gclid-field')];

        if (isGclidValid) {
            gclidFieldContainers.forEach((container) => {
                console.log(container.firstChild);
                container.firstChild.value = gclid.value;
            });
        }
    }

    window.addEventListener('load', addGclid);

    // BES-178: Bing Ads (msclkid) companion to addGclid().
    // Reads the raw `msclkid` URL param Bing Ads attaches to landing URLs,
    // persists it with a 90-day expiry, and populates any form field whose
    // container has the CSS class `js-bing-field`. Mirrors the long-standing
    // gclid flow so the legacy MSCLKID hidden fields work the same way as
    // their GCLID counterparts (which they never did historically).
    function addMsclkid() {
        let msclkidParam = getParam('msclkid');
        let msclkidRecord = null;

        if (msclkidParam) {
            msclkidRecord = getExpiryRecord(msclkidParam);
            localStorage.setItem('msclkid', JSON.stringify(msclkidRecord));
        }

        let msclkid = msclkidRecord || JSON.parse(localStorage.getItem('msclkid'));
        let isMsclkidValid = msclkid && new Date().getTime() < msclkid.expiryDate;

        let msclkidFieldContainers = [...document.getElementsByClassName('js-bing-field')];

        if (isMsclkidValid) {
            msclkidFieldContainers.forEach((container) => {
                if (container.firstChild && 'value' in container.firstChild) {
                    container.firstChild.value = msclkid.value;
                }
            });
        }
    }

    window.addEventListener('load', addMsclkid);

    // UTM parameter persistence (replaces the prior PHP output-buffer link
    // rewriter — see BES-167 / BES-101). Captures utm_* from the landing URL
    // into localStorage with a 90-day expiry, then populates the matching
    // hidden inputs on WPForms forms 18164 / 4157 / 20830 on page load. The
    // form_id -> field_id map below MUST stay in sync with
    // wpf_field_properties_hidden() in functions/functions-forms.php.
    function persistAndPopulateUtms() {
        const UTM_KEYS = [
            'utm_campaign',
            'utm_content',
            'utm_gclid',
            'utm_medium',
            'utm_source',
            'utm_term',
            'utm_msclkid'
        ];

        const FORM_FIELD_MAP = {
            18164: { utm_campaign: 20, utm_content: 21, utm_gclid: 22, utm_medium: 23, utm_source: 24, utm_term: 25, utm_msclkid: 26 },
            4157:  { utm_campaign: 72, utm_content: 73, utm_gclid: 74, utm_medium: 75, utm_source: 76, utm_term: 77, utm_msclkid: 78 },
            20830: { utm_campaign: 20, utm_content: 21, utm_gclid: 22, utm_medium: 23, utm_source: 24, utm_term: 25, utm_msclkid: 26 }
        };

        // 1. Capture: if the current URL has any utm_*, snapshot all present
        //    values together and write them to localStorage.
        let captured = {};
        let foundAny = false;
        UTM_KEYS.forEach(function (key) {
            let value = getParam(key);
            if (value !== null && value !== '') {
                captured[key] = value;
                foundAny = true;
            }
        });

        // BES-178: Google Ads (gclid) and Bing Ads (msclkid) auto-tag landing
        // URLs WITHOUT the utm_ prefix, but our hidden form fields are
        // labelled utm_gclid / utm_msclkid. Fall back to the raw param names
        // so the values actually populate.
        if (!captured.utm_gclid) {
            let gclidParam = getParam('gclid');
            if (gclidParam !== null && gclidParam !== '') {
                captured.utm_gclid = gclidParam;
                foundAny = true;
            }
        }
        if (!captured.utm_msclkid) {
            let msclkidParam = getParam('msclkid');
            if (msclkidParam !== null && msclkidParam !== '') {
                captured.utm_msclkid = msclkidParam;
                foundAny = true;
            }
        }

        if (foundAny) {
            localStorage.setItem('bes_utms', JSON.stringify(getExpiryRecord(captured)));
        }

        // 2. Read the stored snapshot back and check it hasn't expired.
        let stored = null;
        try {
            stored = JSON.parse(localStorage.getItem('bes_utms'));
        } catch (e) {
            stored = null;
        }
        let isValid = stored && stored.value && new Date().getTime() < stored.expiryDate;
        if (!isValid) return;

        // 3. Populate any matching WPForms hidden inputs on this page. Don't
        //    overwrite values already set server-side (i.e. when the request
        //    that rendered the form already had utm_* in the URL).
        Object.keys(FORM_FIELD_MAP).forEach(function (formId) {
            let fieldMap = FORM_FIELD_MAP[formId];
            Object.keys(fieldMap).forEach(function (utmKey) {
                let utmValue = stored.value[utmKey];
                if (!utmValue) return;
                let input = document.getElementById('wpforms-' + formId + '-field_' + fieldMap[utmKey]);
                if (input && !input.value) {
                    input.value = utmValue;
                }
            });
        });
    }

    window.addEventListener('load', persistAndPopulateUtms);

    // ----------------------------------------------------------------------
    // BES-178: cookie persistence + first-landing-page + referrer-page
    // ----------------------------------------------------------------------
    // localStorage remains the source of truth and the mechanism the form
    // population reads from. A `bes_attribution` cookie is written alongside
    // so:
    //   1. The marketing team can verify attribution data in DevTools >
    //      Application > Cookies (the visibility they originally asked for).
    //   2. The server can read it on form-render requests via
    //      wpf_field_properties_hidden(), giving us a fallback for the case
    //      where a user landed earlier in the session and is now submitting
    //      on a page that has no UTMs in its URL.
    //
    // The cookie holds only the slow-changing pieces (utms + first landing).
    // The "previous page" referrer changes every navigation, so populating
    // it server-side from a cookie would always be one hop stale — JS handles
    // that field client-side only.
    // ----------------------------------------------------------------------

    function setBesCookie(name, value, days) {
        let expires = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toUTCString();
        let secure = (location.protocol === 'https:') ? '; Secure' : '';
        document.cookie = name + '=' + encodeURIComponent(value) +
            '; expires=' + expires +
            '; path=/' +
            '; SameSite=Lax' + secure;
    }

    function writeAttributionCookie() {
        let utms = {};
        let firstLanding = '';
        let externalReferrer = '';
        let gclid = '';
        let msclkid = '';
        try {
            let u = JSON.parse(localStorage.getItem('bes_utms'));
            if (u && u.value && u.expiryDate > Date.now()) utms = u.value;
        } catch (e) { /* ignore */ }
        try {
            let l = JSON.parse(localStorage.getItem('bes_first_landing'));
            if (l && l.value && l.expiryDate > Date.now()) firstLanding = l.value;
        } catch (e) { /* ignore */ }
        // BES-193: locked external traffic-source referrer (see
        // captureJourneyAndPopulate). Surfaced in the cookie so the marketing
        // team can verify it in DevTools alongside the other attribution data.
        try {
            let r = JSON.parse(localStorage.getItem('bes_external_referrer'));
            if (r && r.value && r.expiryDate > Date.now()) externalReferrer = r.value;
        } catch (e) { /* ignore */ }
        // gclid and msclkid are persisted by addGclid() / addMsclkid() under
        // their own top-level localStorage keys (not inside bes_utms), so we
        // pull them in separately. Surfacing them at the top of the cookie
        // payload matches how the CRM/marketing team think about them.
        try {
            let g = JSON.parse(localStorage.getItem('gclid'));
            if (g && g.value && g.expiryDate > Date.now()) gclid = g.value;
        } catch (e) { /* ignore */ }
        try {
            let m = JSON.parse(localStorage.getItem('msclkid'));
            if (m && m.value && m.expiryDate > Date.now()) msclkid = m.value;
        } catch (e) { /* ignore */ }
        setBesCookie('bes_attribution', JSON.stringify({
            utms: utms,
            gclid: gclid,
            msclkid: msclkid,
            first_landing_page: firstLanding,
            external_referrer: externalReferrer
        }), 90);
    }

    function captureJourneyAndPopulate() {
        let now = Date.now();
        let currentUrl = window.location.href;

        // ---- First landing: lock once for the 90-day window. ----
        let firstLanding = null;
        try {
            let existing = JSON.parse(localStorage.getItem('bes_first_landing'));
            if (existing && existing.value && existing.expiryDate > now) {
                firstLanding = existing.value;
            }
        } catch (e) { /* ignore */ }
        if (!firstLanding) {
            firstLanding = currentUrl;
            localStorage.setItem('bes_first_landing', JSON.stringify(getExpiryRecord(firstLanding)));
        }

        // ---- Previous page: shift current -> previous on each page load. ----
        let previousUrl = null;
        try {
            let stored = JSON.parse(localStorage.getItem('bes_last_page'));
            if (stored && stored.value && stored.expiryDate > now && stored.value !== currentUrl) {
                previousUrl = stored.value;
            }
        } catch (e) { /* ignore */ }
        // Fallback to document.referrer on the very first internal page
        // load (before we've seeded bes_last_page), but only if it's
        // same-origin — the js-referrer-page field is the *internal* last
        // page, so external referrers are captured separately below.
        if (!previousUrl && document.referrer && document.referrer.indexOf(window.location.origin) === 0) {
            previousUrl = document.referrer;
        }
        // Save current URL as the "last page" for the next pageload.
        localStorage.setItem('bes_last_page', JSON.stringify(getExpiryRecord(currentUrl)));

        // ---- External referrer: lock the original traffic source once. ----
        // BES-193: capture the first external (off-site) document.referrer and
        // lock it for the 90-day window, mirroring first-landing behaviour.
        // This is the true traffic source (e.g. google.com organic, a partner
        // site) and matters most for channels that don't fire UTMs. Unlike
        // js-referrer-page (internal last page) this is never overwritten by
        // subsequent internal navigation.
        let externalReferrer = null;
        try {
            let existingExt = JSON.parse(localStorage.getItem('bes_external_referrer'));
            if (existingExt && existingExt.value && existingExt.expiryDate > now) {
                externalReferrer = existingExt.value;
            }
        } catch (e) { /* ignore */ }
        if (!externalReferrer && document.referrer &&
            document.referrer.indexOf(window.location.origin) !== 0) {
            externalReferrer = document.referrer;
            localStorage.setItem('bes_external_referrer', JSON.stringify(getExpiryRecord(externalReferrer)));
        }

        // Mirror the slow-changing pieces to the cookie now that first
        // landing is settled. persistAndPopulateUtms runs before this
        // handler (registered earlier), so bes_utms is already up to date.
        writeAttributionCookie();

        // ---- Populate hidden form-field containers by CSS class hook. ----
        // Matches the long-standing js-gclid-field pattern: WPForms wraps
        // each hidden input in a container <div> that carries the chosen
        // CSS class.
        function fill(className, value) {
            if (!value) return;
            [...document.getElementsByClassName(className)].forEach(function (container) {
                let input = (container.tagName === 'INPUT')
                    ? container
                    : (container.querySelector('input') || container.firstElementChild);
                if (input && 'value' in input && !input.value) {
                    input.value = value;
                }
            });
        }
        fill('js-first-landing-page', firstLanding);
        fill('js-referrer-page', previousUrl);
        fill('js-external-referrer', externalReferrer);
    }

    window.addEventListener('load', captureJourneyAndPopulate);
</script>

</body>

</html>