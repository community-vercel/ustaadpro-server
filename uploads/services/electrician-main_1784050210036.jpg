<script type="text/javascript">
		document.addEventListener("DOMContentLoaded", function() {
			var if_ssb_exist = document.getElementsByClassName( "simplesocialbuttons" ).length > 0;
			if (if_ssb_exist) {
				var ssb_admin_ajax = 'https://www.staticelectrics.com.au/wp-admin/admin-ajax.php';
				var ssb_post_id = 36572 ;
				var ssb_post_url = 'https://www.staticelectrics.com.au/electricians-blog/connect-generator-to-house/';
				var ssb_alternate_post_url = 'https://www.staticelectrics.com.au/electricians-blog/connect-generator-to-house/';
				jQuery( document ).ready(function(){
				var is_ssb_used = jQuery('.simplesocialbuttons');
				if( is_ssb_used ) {

					var data = {
					'action'   : 'ssb_fetch_data',
					'postID'   :  ssb_post_id,
					'security' : '0b3b096dfa'
					};
					jQuery.post(ssb_admin_ajax, data, function(data, textStatus, xhr) {
						var array = JSON.parse(data);

						jQuery.each( array, function( index, value ){

							if( index == 'total' ){
								jQuery('.ssb_'+ index +'_counter').html(value + '<span>Shares</span>');
							}else{
								jQuery('.ssb_'+ index +'_counter').html(value);
							}
						});

					});
				}
				})

			//ssbPlugin.fetchFacebookShares();
			}
		});

		</script><script>
