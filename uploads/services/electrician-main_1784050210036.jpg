<script data-minify="1" data-api-key="edrsift5npqe0xcrgrjc08nz" data-schedulerid="sched_opww5qkcj66bvmx9q61oz8cw" defer id="se-widget-embed" src="https://www.staticelectrics.com.au/wp-content/cache/min/1/scheduler-v1.js?ver=1784034738"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Define the selector to find all target links
        const selector = 'a[href="#contact-form-section"]';
       
        // Define the ServiceTitan scheduling function
        const schedulerFunction = "_scheduler.show({ schedulerId: 'sched_opww5qkcj66bvmx9q61oz8cw' })";
        // Find all matching elements
        const linksToModify = document.querySelectorAll(selector);

        // Loop through each found link and apply the changes
        linksToModify.forEach(link => {
            // 1. Remove the existing href attribute
            link.removeAttribute('href');
            
            // 2. Set the onclick attribute to launch the ServiceTitan scheduler
            link.setAttribute('onclick', schedulerFunction);

            // 3. Remove the target attribute (if it exists)
            link.removeAttribute('target');

            // 4. ADD the new class "service-titan-popup"
            link.classList.add('service-titan-popup');

            // OPTIONAL: Prevent default click behavior to ensure smooth operation
            link.addEventListener('click', function(event) {
                event.preventDefault();
            });
            
            console.log('Modified link:', link); // For debugging
        });
    });
</script>
