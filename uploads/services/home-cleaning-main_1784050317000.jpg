<script type="0713727a8b0bcb84e4464574-text/javascript">
   jQuery(document).ready(function($){
           setTimeout(function(){
     $('.flatpickr-input').each(function(){ flatpickr( $(this)[0] ).set('dateFormat', 'd/m/Y');}); }, 1000 );
