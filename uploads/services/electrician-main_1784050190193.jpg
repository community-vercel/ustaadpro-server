	//Fix for ST modal placement bug
	function centerModal() {
		const modal = document.querySelector('.se-widget-iframe-container');
		if (modal) {
			modal.style.position = 'fixed';
			modal.style.top = '50%';
			modal.style.left = '50%';
// 			modal.style.transform = 'translate(-50%, -50%)';
			modal.style.bottom = 'auto';
