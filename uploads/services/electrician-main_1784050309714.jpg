<a href="#page" class="btn btn-secondary shadows rounded-cricle d-flex align-items-center justify-content-center p-0 pe-auto position-sticky position-fixed back-to-top-link " aria-label="Scroll to Top" ><i class="fa fa-angle-up"></i></a></div><div class="electro-overlay"></div> <script type="speculationrules">{"prefetch":[{"source":"document","where":{"and":[{"href_matches":"/*"},{"not":{"href_matches":["/wp-*.php","/wp-admin/*","/wp-content/uploads/*","/wp-content/*","/wp-content/plugins/*","/wp-content/themes/electro/*","/*\\?(.+)"]}},{"not":{"selector_matches":"a[rel~=\"nofollow\"]"}},{"not":{"selector_matches":".no-prefetch, .no-prefetch a"}}]},"eagerness":"conservative"}]}</script> <script>document.addEventListener("DOMContentLoaded", function () {
        /* 1. Inject images into radio labels */
        const radioImageMap = {
            'AcType-Inverter': 'https://www.kamkaj.pk/Content/images/offer/ac/ac-check1.png',
            'AcType-Non Inverter': 'https://www.kamkaj.pk/Content/images/offer/ac/ac-check.png',
            'ServiceType-Repair': 'https://www.kamkaj.pk/Content/images/offer/ac/AC-repair.png',
            'ServiceType-Install': 'https://www.kamkaj.pk/Content/images/offer/ac/ac-repair-install-services.png',
            'ServiceType-Service': 'https://www.kamkaj.pk/Content/images/offer/ac/ac-service.png',
            'ServiceType-Visit for Estimation': 'https://www.kamkaj.pk/Content/images/offer/home-appliance/visittodignose.png'
        };
        Object.entries(radioImageMap).forEach(([key, url]) => {
            const parts = key.split('-');
            const name = parts[0];
            const val = parts.slice(1).join('-');
            const selector = `input[name="${name}"][value="${val}"]`;
            const input = document.querySelector(selector);
            if (input) {
                const label = input.closest('label');
                if (label && !label.querySelector('img')) {
                    const img = document.createElement('img');
                    img.src = url;
                    img.alt = val;
                    label.insertBefore(img, label.firstChild);
                }
            }
        });

        /* 2. Show/hide dependent sub-service fields */
        function toggleSubServices() {
            const selected = document.querySelector('input[name="ServiceType"]:checked')?.value;
            const srv1 = document.querySelector('[name="Service1"]')?.closest('.elementor-field');
            const srv2 = document.querySelector('[name="Service2"]')?.closest('.elementor-field');
            if (srv1) srv1.style.display = (selected === 'Install') ? 'block' : 'none';
            if (srv2) srv2.style.display = (selected === 'Service') ? 'block' : 'none';
        }
        toggleSubServices();
        document.querySelectorAll('input[name="ServiceType"]').forEach(el => {
            el.addEventListener('change', toggleSubServices);
        });

        /* 3. Add +/- buttons to quantity fields */
        const qtyIds = ['ACSize_1_Ton','ACSize_1_5_Ton','ACSize_2_Ton','ACSize_2_Plus_Ton'];
        qtyIds.forEach(name => {
            const input = document.querySelector(`input[name="${name}"]`);
            if (!input) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'qty-buttons';

            const minus = document.createElement('button');
            minus.type = 'button'; minus.textContent = '-';
            minus.addEventListener('click', () => {
                let v = parseInt(input.value) || 0;
                if (v>0) input.value = v - 1;
            });

            const plus = document.createElement('button');
            plus.type = 'button'; plus.textContent = '+';
            plus.addEventListener('click', () => {
                let v = parseInt(input.value) || 0;
                input.value = v + 1;
            });

            input.parentNode.insertBefore(wrapper, input);
            wrapper.appendChild(minus);
            wrapper.appendChild(input);
            wrapper.appendChild(plus);
        });
    });</script> <div class="ht-ctc ht-ctc-chat ctc-analytics ctc_wp_desktop style-2  ht_ctc_entry_animation ht_ctc_an_entry_corner " id="ht-ctc-chat"
