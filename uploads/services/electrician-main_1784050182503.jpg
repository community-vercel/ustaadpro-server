<script type="text/rocketlazyloadscript">
document.addEventListener("DOMContentLoaded", function () {

  document.querySelectorAll("img").forEach(img => {

    // Skip decorative images
    if (img.getAttribute("role") === "presentation") return;

    // If title already exists, do nothing
    if (img.hasAttribute("title")) return;

    // Priority: ALT → aria-label → filename
    let title =
      img.getAttribute("alt") ||
      img.getAttribute("aria-label") ||
      img.src.split('/').pop().split('.')[0].replace(/[-_]/g, ' ');

    if (title) {
      img.setAttribute("title", title.trim());
    }
  });

});
</script>
<script type="text/rocketlazyloadscript">window.addEventListener('DOMContentLoaded', function() {
jQuery(document).on('elementor/popup/show', function (event, popupId) {

    if (popupId !== 1373) return; // your popup ID

    const popupSelector = '#elementor-popup-modal-' + popupId;

    let attempts = 0;
    const maxAttempts = 20;

    const focusTimer = setInterval(function () {
        const $input = jQuery(popupSelector).find('input.e-search-input');

        if ($input.length) {
            // force focus
            $input[0].focus({ preventScroll: true });

            // force caret position
            const val = $input.val();
            $input.val('').val(val);

            attempts++;
        }

        if (attempts >= maxAttempts) {
            clearInterval(focusTimer);
        }
    }, 100);
});
});</script>
