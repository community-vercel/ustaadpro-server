<div class="entry-content single-content">
			<div data-elementor-type="wp-page" data-elementor-id="1976" class="elementor elementor-1976">
				<div class="elementor-element elementor-element-27786249 e-flex e-con-boxed e-con e-parent" data-id="27786249" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
