(function(){
  function strip(root){
    (root||document).querySelectorAll('script[src*="trustindex.io"],[class*="ti-widget"],[class*="ti-container"],[id*="trustindex"]').forEach(function(n){ n.remove(); });
  }
  function run(){ strip(document); }
  if (document.readyState !== 'loading') run(); else document.addEventListener('DOMContentLoaded', run);
  // Trustindex loader is async — catch the widget whenever it injects, then stop.
  try {
    var obs = new MutationObserver(function(){ strip(document); });
    obs.observe(document.documentElement, { childList:true, subtree:true });
    setTimeout(function(){ obs.disconnect(); }, 8000);
  } catch(e){}
})();
