            var items_new_cart = [];

            var total = $('.totals__subtotal-value').text();

            $(".cart-item").each(function () {

              console.log('3214');

              var item_id1 = $(this).find('.quantity__input').attr('data-quantity-variant-id');
              var item_name1 = $(this).find('.cart-item__name').text();
              var index1 =  $(this).index();
              var item_brand1 = '';
              var item_category1 = '';
              var item_category21 = '';
              var item_list_id1 = $(this).find('.quantity__input').attr('data-quantity-variant-id');
              var item_list_name1 = $(this).find('.product-option dd').text();
              var item_variant1 = $(this).find('.quantity__input').attr('data-quantity-variant-id');
              var price1 = $(this).find('.cart-item__price-wrapper .price').text();
              var quantity1 = $(this).find('.quantity__input').val();

              // dataLayer.push({ ecommerce: null });

              var item = {};

              item.item_id = item_id1;
              item.item_name = item_name1;
              item.index = index1;
              item.item_brand = item_brand1;
              item.item_category = item_category1;
              item.item_category2 = item_category21;
              item.item_list_id = item_list_id1;
              item.item_list_name = item_list_name1;
              item.item_variant = item_variant1;
              item.price = price1;
              item.quantity = '1';

              items_new_cart.push(item);

            });


            dataLayer.push({ ecommerce: null });

            dataLayer.push({
              event: 'view_cart',
              ecommerce: {
                currency: 'INR',
                value: total,
                items: items_new_cart,
              }
            });

          }, 1000);

        });

