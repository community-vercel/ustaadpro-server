        window._starapps_shop_themes = {"176857973040":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"177950163248":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"169605595440":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"169742631216":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"170067951920":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"162303050032":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"152865243440":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"163234971952":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"165539479856":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"166055051568":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"166742589744":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"167115587888":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"167270613296":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"168416379184":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"168656011568":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"169465381168":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"175240839472":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"175262761264":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"179661242672":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"147986186544":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"174080426288":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"142979858736":{"theme_setting_id":247127,"theme_store_id":"887","schema_theme_name":"Dawn"},"179874300208":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"178096144688":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"178404000048":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"},"172022530352":{"theme_setting_id":247127,"theme_store_id":null,"schema_theme_name":"Dawn"}};

        document.addEventListener('DOMContentLoaded', function () {
        function loadThemeScript() {
          const { theme } = window.Shopify;
          const themeSettings = window._starapps_theme_settings || [];
          const shopThemes = window._starapps_shop_themes || {};

          if (!themeSettings.length) {
            return;
          }

          const currentThemeId = theme.id.toString();
          let shopTheme = null;

          shopTheme = shopThemes[currentThemeId];

          if (!shopTheme) {
            for (const [themeId, themeData] of Object.entries(shopThemes)) {
              if (themeData.schema_theme_name === theme.schema_name ||
                  themeData.theme_store_id === theme.theme_store_id.toString()) {
                shopTheme = themeData;
                break;
              }
            }
          }

          if (!shopTheme) {
            console.log('No shop theme found for theme:', theme);
            return;
          }

          // Step 2: Find the theme setting using the theme_setting_id from shop theme
          const themeSetting = themeSettings.find(ts => ts.id === shopTheme.theme_setting_id);

          console.log(themeSettings);
          console.log(shopTheme);

          if (!themeSetting) {
            console.log('No theme setting found for theme_setting_id:', shopTheme.theme_setting_id);
            return;
          }

          // Load script if found and not already loaded
          if (themeSetting.script_url && !isScriptAlreadyLoaded(themeSetting.id)) {
            loadScript(themeSetting);
          }
        }

        function isScriptAlreadyLoaded(themeSettingId) {
          return document.querySelector(`script[data-theme-script="${themeSettingId}"]`) !== null;
        }

        function loadScript(themeSetting) {
          const script = document.createElement('script');
          script.src = themeSetting.script_url;
          script.async = true;
          script.crossOrigin = 'anonymous';
          script.setAttribute('data-theme-script', themeSetting.id);

          document.head.appendChild(script);
        }

          // Try immediately, otherwise wait for Shopify theme object
          if (window.Shopify && window.Shopify.theme && window.Shopify.theme.id) {
            loadThemeScript();
          } else {
            var interval = setInterval(function () {
              if (window.Shopify && window.Shopify.theme && window.Shopify.theme.id) {
                clearInterval(interval);
                loadThemeScript();
              }
            }, 100);
            setTimeout(function () { clearInterval(interval); }, 5000);
          }
        });
      </script>
    

    

    
    
