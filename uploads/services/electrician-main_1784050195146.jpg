    // remove_from_cart

    $('.header__icon--cart').click(function(){

      $('cart-remove-button .button').click(function(){
        var item_id1 = $(this).closest('.cart-item').find('.quantity__input').attr('data-quantity-variant-id');
        var item_name1 = $(this).closest('.cart-item').find('.cart-item__name').text();
        var index1 =  $(this).closest('.cart-item').index();
        var item_brand1 = '';
        var item_category1 = '';
        var item_category21 = '';
        var item_list_id1 = $(this).closest('.cart-item').find('.quantity__input').attr('data-quantity-variant-id');
        var item_list_name1 = $(this).closest('.cart-item').find('.product-option dd').text();
        var item_variant1 = $(this).closest('.cart-item').find('.quantity__input').attr('data-quantity-variant-id');
        var price1 = $(this).closest('.cart-item').find('.cart-drawer .price').text();
        var quantity1 = $(this).closest('.cart-item').find('.quantity__input').val();

        dataLayer.push({ ecommerce: null });
        dataLayer.push({
          event: 'remove_from_cart',
          ecommerce: {
            currency: 'INR',
            value: price1,
            items: [
              {
                item_id: item_id1,
                item_name: item_name1,
                index: index1,
                item_brand: item_brand1,
                item_category: item_category1,
                item_category2: item_category21,
                item_list_id: item_list_id1,
                item_list_name: item_list_name1,
                item_variant: item_variant1,
                price: price1,
                quantity: quantity1
              }
            ]
          }
        });

      });
    });

    // begin_checkout
    $('.cart__checkout-button').click(function(){

      var item_id1 = $(this).closest('cart-drawer-items').find('.quantity__input').attr('data-quantity-variant-id');
      var item_name1 = $(this).closest('cart-drawer-items').find('.cart-item__name').text();
      var index1 =  $(this).closest('cart-drawer-items').index();
      var item_brand1 = '';
      var item_category1 = '';
      var item_category21 = '';
      var item_list_id1 = $(this).closest('cart-drawer-items').find('.quantity__input').attr('data-quantity-variant-id');
      var item_list_name1 = $(this).closest('cart-drawer-items').find('..product-option dd').text();
      var item_variant1 = $(this).closest('cart-drawer-items').find('.quantity__input').attr('data-quantity-variant-id');
      var price1 = $(this).closest('cart-drawer-items').find('.product-option:first-child').text();
      var quantity1 = $(this).closest('cart-drawer-items').find('.quantity__input').val();

      dataLayer.push({ ecommerce: null });
      dataLayer.push({
        event: 'begin_checkout',
        ecommerce: {
          currency: 'INR',
          value: price1,
          items: [
            {
              item_id: item_id1,
              item_name: item_name1,
              index: index1,
              item_brand: item_brand1,
              item_category: item_category1,
              item_category2: item_category21,
              item_list_id: item_list_id1,
              item_list_name: item_list_name1,
              item_variant: item_variant1,
              price: price1,
              quantity: quantity1
            }
          ]
        }
      });
    });

